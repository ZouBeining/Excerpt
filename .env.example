# (required) This must be set among MW (for Merriam-Webster) and FD (for Free Dictionary)
DICT_CHOICE=

# (optional) If the dictionary you chooses requires a API Key, put it here
DICT_API_KEY=

# (optional) To customize the output directory, put your preferred path here
OUTPUT_DIR=

# (optional) To customize the cache path, put your preferred path here
# default: ~/.cache/excerpt/words.json
EXCERPT_CACHE_PATH=

# (required) Set this to True or False
USE_LLM=

# (required if using LLM) Fill in OpenAI compatiable API Key and Base URL here
OPENAI_API_KEY=
OPENAI_BASE_URL=

# (required if using LLM) Put your preferred model here
OPENAI_MODEL=