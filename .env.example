# (optional) Which dictionary to use: MW (Merriam-Webster) or FD (Free Dictionary)
# default: MW
DICT_CHOICE=

# (optional) Only needed if the dictionary you choose requires an API key.
DICT_API_KEY=

# (optional) Dictionary network tuning.  This block covers the dictionary stage
# only; the LLM stage has its own LLM_* settings further down, because a
# dictionary GET and a model completion fail in completely different ways.
# TIMEOUT: seconds allowed per dictionary request        (default: 20.0)
# RETRY:   retries after a failed request                (default: 3)
# DELAY:   seconds to wait between two requests          (default: 0.2)
# PROXY:   proxy URL, e.g. http://127.0.0.1:7890         (default: none)
TIMEOUT=
RETRY=
DELAY=
PROXY=

# (optional) To customize the output directory, put your preferred path here
OUTPUT_DIR=

# (optional) To customize the dictionary cache file, put your preferred path here
# default: ~/.cache/excerpt/{dict_slug}.cache.json
EXCERPT_CACHE_PATH=

# (optional) To move the whole cache directory, put your preferred path here.
# This is a *directory* (unlike EXCERPT_CACHE_PATH above, which names one file)
# and it covers every cached artifact at once: the dictionary cache, the LLM
# completion cache ({model}.cache.json) and the LLM preflight verdict
# (llm.check.json).
# default: ~/.cache/excerpt
EXCERPT_CACHE_DIR=

# (optional) Compile the generated .tex into a PDF with xelatex (True/False)
# default: False
COMPILE_LATEX=

# (optional) Path to the xelatex executable, if it is not on PATH
# default: auto-detected (PATH, then common MiKTeX / TeX Live locations)
XELATEX=

# (optional) Complete the non-word entries with an LLM (True/False)
# default: False
USE_LLM=

# (required if using LLM) Fill in OpenAI compatiable API Key and Base URL here
# OPENAI_BASE_URL may be either the API root (e.g. https://openrouter.ai/api/v1)
# or the full completions endpoint (a trailing /chat/completions is stripped).
OPENAI_API_KEY=
OPENAI_BASE_URL=

# (required if using LLM) Put your preferred model here
OPENAI_MODEL=

# (optional) LLM-only timeout, retry budget and backoff, in seconds and
# attempts.  Deliberately independent of TIMEOUT/RETRY/DELAY above, which cover
# the dictionary only: a reasoning model routinely needs far longer than the
# 20s that suits a dictionary GET.
# defaults: 60.0 / 3 / 0.5
LLM_TIMEOUT=
LLM_RETRIES=
LLM_BACKOFF=

# (optional) How many LLM requests may be in flight at once.
# 1 (the default) is strictly sequential, i.e. the historical behaviour.
# Raising it shortens the run but can trip rate limits on free tiers.
# Must be between 1 and 16.
LLM_WORKERS=

# (optional) Raw JSON merged into every LLM request body, used to stop a
# reasoning model from "thinking". Providers spell this field differently and
# there is no standard, so the tool tries a list of known spellings on its own;
# set this only when your provider needs one that is not detected automatically.
# Highest priority: whatever you put here is sent first.
# examples:
#   LLM_REASONING={"reasoning_effort": "minimal"}
#   LLM_REASONING={"reasoning": {"enabled": false}}
#   LLM_REASONING={"chat_template_kwargs": {"thinking": false}}
LLM_REASONING=
